# --- Local Development (Google AI Studio) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_api_key_here

# --- Google Cloud Deployment (Vertex AI Agent Engine & Cloud Run) ---
